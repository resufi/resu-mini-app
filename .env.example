VITE_NETWORK=mainnet
VITE_TON_ENDPOINT=
VITE_TONCENTER_API_KEY=
VITE_TONCONNECT_MANIFEST_URL=

# Сеть Solana: devnet (по умолчанию) или mainnet.
VITE_SOLANA_NETWORK=devnet

# Свой RPC для Solana вместо публичного.
VITE_SOLANA_RPC=

# Идентификатор проекта WalletConnect — без него этот способ подключения
# не работает. Бесплатно на dashboard.reown.com, регистрация за минуту.
# Он публичный по назначению: попадает в бандл и виден всем.
VITE_WALLETCONNECT_PROJECT_ID=

# Telegram Mini App: адрес, на который кошелёк возвращает человека после
# подписи. Формат https://t.me/<bot>/<app>. Без него TonConnect после
# подтверждения оставит пользователя в кошельке.
VITE_TWA_RETURN_URL=

# Публичный адрес мини-аппа. Нужен только там, где его нельзя вывести из
# window.location — например, в ссылке «открыть в браузере».
VITE_SITE_URL=
